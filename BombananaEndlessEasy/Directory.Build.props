<Project>

  <!--
    Machine-specific paths belong in Directory.Build.user.props (gitignored; see the
    .example file next to this one). This file only supplies portable defaults, so a fresh
    clone builds without editing anything.

    Everything is derived from the standard r2modman / Thunderstore Mod Manager layout
    under %APPDATA%.
  -->

  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.user.props"
          Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.user.props')" />

  <PropertyGroup>
    <BombananaProfileDir Condition="'$(BombananaProfileDir)' == ''">$(APPDATA)\r2modmanPlus-local\Bombanana\profiles\Default</BombananaProfileDir>

    <!-- Where the built DLL is deployed. BepInEx 6 scans this folder recursively. -->
    <BombananaPluginsDir Condition="'$(BombananaPluginsDir)' == ''">$(BombananaProfileDir)\BepInEx\plugins</BombananaPluginsDir>

    <!-- Il2Cpp interop proxies generated by BepInEx on the game's first launch. -->
    <BepInExInteropDir Condition="'$(BepInExInteropDir)' == ''">$(BombananaProfileDir)\BepInEx\interop</BepInExInteropDir>

    <!-- BOMBANANA Library, installed by the mod manager into its own plugins subfolder. -->
    <BombananaLibraryDll Condition="'$(BombananaLibraryDll)' == '' And Exists('$(BombananaPluginsDir)\JekaJeka0-BOMBANANA_Library')">$(BombananaPluginsDir)\JekaJeka0-BOMBANANA_Library\BOMBANANA.Library-1.0.0.dll</BombananaLibraryDll>
  </PropertyGroup>

</Project>
