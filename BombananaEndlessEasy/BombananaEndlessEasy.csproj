<Project Sdk="Microsoft.NET.Sdk">

  <!--
    BOMBANANA! is Unity IL2CPP + BepInEx 6 (bleeding edge, BepInExPack_BOMBANANA 6.0.755).

    TargetFramework = net6.0 is NOT optional here.
    BepInEx 6 IL2CPP plugins run on the .NET 6 runtime that BepInEx itself hosts, and the
    generated Il2Cpp interop assemblies are net6.0. netstandard2.1 / net472 (the Mono-era
    choices) will compile but the loader will reject the plugin at runtime.
    Source of truth: BepInEx.Templates -> templates/BepInEx6.PluginTemplate.Unity.Il2Cpp
  -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>BombananaEndlessEasy</AssemblyName>
    <RootNamespace>BombananaEndlessEasy</RootNamespace>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <DebugType>portable</DebugType>

    <!-- BepInEx ships its packages on its own NuGet feed, not nuget.org only. -->
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

  <!--
    BepInEx 6 IL2CPP API (BasePlugin, ConfigFile, ManualLogSource) + HarmonyX, transitively.
    IncludeAssets="compile" is what the official template does: it gives us the reference at
    compile time but keeps BepInEx's own runtime DLLs OUT of bin/ so we never ship a second
    copy of BepInEx into the user's plugins folder.
  -->
  <ItemGroup>
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.*" IncludeAssets="compile" />
  </ItemGroup>

  <!--
    ============================================================
    Game assemblies (used from step 3 onward).
    These are IL2CPP interop proxies generated by BepInEx into BepInEx/interop, NOT the
    metadata-only Assembly-CSharp.dll from BOMBANANA_Data/Managed.
    Every one of them must stay <Private>false</Private>: they already exist in the game.
    Paths come from Directory.Build.props; they are optional, so step 1 still builds with
    nothing but the NuGet reference above.
    ============================================================
  -->
  <ItemGroup Condition="'$(BepInExInteropDir)' != '' And Exists('$(BepInExInteropDir)')">
    <Reference Include="Assembly-CSharp">
      <HintPath>$(BepInExInteropDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(BepInExInteropDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(BepInExInteropDir)\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- BOMBANANA Library: a runtime dependency installed by the mod manager, so never copy it. -->
  <ItemGroup Condition="'$(BombananaLibraryDll)' != '' And Exists('$(BombananaLibraryDll)')">
    <Reference Include="BOMBANANA.Library">
      <HintPath>$(BombananaLibraryDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    Deploy the built DLL straight into the profile's plugins folder.
    Set BombananaPluginsDir in Directory.Build.props, or override per build:
        dotnet build -p:BombananaPluginsDir="C:\path\to\BepInEx\plugins"
    If it is not set the build still succeeds, it just does not copy.
  -->
  <Target Name="DeployToPlugins" AfterTargets="Build"
          Condition="'$(BombananaPluginsDir)' != '' And Exists('$(BombananaPluginsDir)')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BombananaPluginsDir)" />
    <Message Importance="high" Text="Deployed $(TargetFileName) -> $(BombananaPluginsDir)" />
  </Target>

  <Target Name="WarnMissingPluginsDir" AfterTargets="Build"
          Condition="'$(BombananaPluginsDir)' == ''">
    <Message Importance="high"
             Text="NOTE: BombananaPluginsDir is not set, so the DLL was NOT copied. Output: $(TargetPath)" />
  </Target>

</Project>
